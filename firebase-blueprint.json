{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Public storefront catalog item (watch or electronics) visible to all visitors without exposing wholesale cost.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique document ID matching the Firestore document path ID."
        },
        "product_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Display product title shown on storefront cards and search."
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Manufacturer or brand name."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Model number or model name."
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Visible dial, strap, or casing finish."
        },
        "category": {
          "type": "string",
          "enum": [
            "Analog Watches",
            "Digital Watches",
            "Smartwatches",
            "TWS Earbuds",
            "Power Banks",
            "Chargers & Cables",
            "Bluetooth Speakers",
            "Neckbands",
            "Gadgets & Accessories"
          ],
          "description": "Storefront product category."
        },
        "connectivity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Watch movement or electronics connectivity specification."
        },
        "capacity_spec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Case size/water resistance or battery/wattage specification."
        },
        "display_buying_price": {
          "type": "number",
          "description": "High anchor/tag price in BDT shown to customers."
        },
        "min_selling_price": {
          "type": "number",
          "description": "Lowest selling/offer price in BDT shown to customers."
        },
        "stock_count": {
          "type": "integer",
          "description": "Available inventory units."
        },
        "image_url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500000,
          "description": "Cloudinary HTTPS URL or compressed image Data URL."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1200,
          "description": "Customer-facing product summary."
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Email of the verified shop admin who created the item."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "id",
        "brand",
        "model",
        "color",
        "category",
        "connectivity",
        "capacity_spec",
        "display_buying_price",
        "min_selling_price",
        "stock_count",
        "image_url",
        "description",
        "ownerEmail",
        "created_at",
        "updated_at"
      ]
    },
    "ProductCost": {
      "title": "ProductCost",
      "description": "Admin-only secret wholesale purchase cost isolated from the public storefront catalog.",
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Foreign key matching /products/{productId}."
        },
        "real_buying_price": {
          "type": "number",
          "description": "Actual secret wholesale buying cost in BDT."
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified shop owner email."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["product_id", "real_buying_price", "ownerEmail", "updated_at"]
    },
    "SalesMemo": {
      "title": "SalesMemo",
      "description": "Admin-only digital invoice / receipt record containing customer PII and billed line items.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique memo ID."
        },
        "invoice_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Formatted invoice reference number."
        },
        "customer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Customer name on receipt."
        },
        "customer_phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "Customer phone number."
        },
        "payment_method": {
          "type": "string",
          "enum": ["Cash", "bKash", "Nagad", "Card"],
          "description": "Payment mode."
        },
        "discount_amount": {
          "type": "number",
          "description": "Discount applied in BDT."
        },
        "total_amount": {
          "type": "number",
          "description": "Net payable total in BDT."
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Warranty or invoice notes."
        },
        "items": {
          "type": "array",
          "description": "Bounded list of billed product items (max 50)."
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified shop owner email."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "id",
        "invoice_number",
        "customer_name",
        "customer_phone",
        "payment_method",
        "discount_amount",
        "total_amount",
        "notes",
        "items",
        "ownerEmail",
        "created_at"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized shopkeeper admin document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the admin."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified email address."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["uid", "email", "created_at"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public storefront catalog items readable by all visitors and writable only by verified admins."
    },
    "/product_costs/{productId}": {
      "schema": { "$ref": "#/entities/ProductCost" },
      "description": "Secret wholesale cost records isolated from public customers; readable and writable only by verified admins."
    },
    "/sales_memos/{memoId}": {
      "schema": { "$ref": "#/entities/SalesMemo" },
      "description": "Digital sales memos containing customer PII; readable and writable only by verified admins."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role allowlist managed by the bootstrapped store owner."
    }
  }
}
