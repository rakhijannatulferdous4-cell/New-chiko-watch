# ==========================================
# NEW CHIKO WATCH — ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase (Optional — app runs 100% locally via localStorage until connected)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Cloudinary 25GB Free Cloud Media Storage (keeps Supabase DB under 5MB even with 10,000+ products!)
# Option 1 (Easiest): Paste your full Cloudinary API Environment Variable from Cloudinary Dashboard
CLOUDINARY_URL=""
# Option 2 (Separate keys — Server-side signed uploads, most secure)
CLOUDINARY_CLOUD_NAME="zxamensn"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Option 3 (Unsigned preset — works without API Secret)
CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="zxamensn"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Google Gemini API (Server-side only — automatically injected in AI Studio Secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Admin Authentication Credentials (Server-side checked)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="chiko123"

# App URL (Injected automatically in AI Studio)
APP_URL="MY_APP_URL"
