# ==========================================
# NEW CHIKO WATCH — ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase (Optional — app runs 100% locally via localStorage until connected)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Cloudinary (Default cloud name: zxamensn)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="zxamensn"
# Optional unsigned upload preset for direct browser uploads (falls back to local compressed image if blank)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Google Gemini API (Server-side only — automatically injected in AI Studio Secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Admin Authentication Credentials (Server-side checked)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="chiko123"

# App URL (Injected automatically in AI Studio)
APP_URL="MY_APP_URL"
